# Tennis Data API
# Get a trial key at: https://developer.sportradar.com/
SPORTRADAR_API_KEY=your_sportradar_key_here
SPORTRADAR_BASE_URL=https://api.sportradar.com/tennis/trial/v3/en

# api-tennis.com (primary live source)
# Get a key at: https://api-tennis.com/
APITENNIS_API_KEY=your_api_tennis_key

# AI APIs
# Get keys from their respective developer portals
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Redis (Upstash) - Optional for local dev (will use in-memory fallback)
# Get credentials at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_TIMEOUT_MS=15000

# Replay / recording (optional)
# RECORD_MATCHES=1 saves live snapshots to REPLAY_DIR during a trial
RECORD_MATCHES=0
# Folder of recordings, relative to the project root
REPLAY_DIR=data/replays
# Playback speed multiplier and shared-clock epoch (ms)
REPLAY_SPEED=1
REPLAY_EPOCH=0

# Data providers, in failover order. Unknown ids are ignored.
# Available: sportradar, apitennis, replay
TENNIS_PROVIDERS=sportradar,apitennis,replay
