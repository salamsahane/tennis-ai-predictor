# Tennis Data API
# Get a trial key at: https://developer.sportradar.com/
SPORTRADAR_API_KEY=your_sportradar_key_here
SPORTRADAR_BASE_URL=https://api.sportradar.com/tennis/trial/v3/en

# AI APIs
# Get keys from their respective developer portals
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Redis (Upstash) - Optional for local dev (will use in-memory fallback)
# Get credentials at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
POLL_INTERVAL_MS=10000
AI_TIMEOUT_MS=15000
